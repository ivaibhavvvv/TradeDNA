# ============================================================
# TRADEDNA PRODUCTION CONFIGURATION TEMPLATE
# ============================================================
# NOTE: In production, secrets MUST be injected via secure secret managers
# (e.g. AWS Secrets Manager, HashiCorp Vault, Kubernetes Secrets).
# DO NOT commit real production passwords or private keys to Git.

# Environment & Observability
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=False

# Application URLs
APP_BASE_URL=https://app.tradedna.io
API_BASE_URL=https://api.tradedna.io
API_V1_PREFIX=/api/v1

# Security & Cryptography (Generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_ENTROPY_SIGNING_KEY_IN_PRODUCTION
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_ENTROPY_REFRESH_KEY_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pairing Token Security
PAIRING_TOKEN_EXPIRE_MINUTES=5
PAIRING_MAX_ATTEMPTS_PER_HOUR=3

# Database (Production PostgreSQL 16 - Isolated Internal Network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tradedna_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
POSTGRES_DB=tradedna_prod_db
DATABASE_URL=postgresql+asyncpg://tradedna_prod_user:REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD@postgres:5432/tradedna_prod_db
DATABASE_URL_SYNC=postgresql+psycopg2://tradedna_prod_user:REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD@postgres:5432/tradedna_prod_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# Redis Cache & Broker (Isolated Internal Network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS (Strict production domain only - NO WILDCARDS OR LOCALHOST)
ALLOWED_ORIGINS=["https://app.tradedna.io","https://tradedna.io"]

# Browser & Cookie Hardening
COOKIE_SECURE=True
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=.tradedna.io
SECURE_HEADERS_ENABLED=True
HSTS_ENABLED=True
