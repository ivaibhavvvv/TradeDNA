# ============================================================
# TRADEDNA CONFIGURATION ENVIRONMENT TEMPLATE
# ============================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Application URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Security & Cryptography
# Generate with: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_signing_key_32bytes_minimum_length_required_here
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_32bytes_minimum_length_required
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_USER=tradedna_user
POSTGRES_PASSWORD=tradedna_secure_password
POSTGRES_DB=tradedna_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tradedna_user:tradedna_secure_password@localhost:5432/tradedna_db
DATABASE_URL_SYNC=postgresql+psycopg2://tradedna_user:tradedna_secure_password@localhost:5432/tradedna_db

# Redis Cache & Task Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Optional in early phases)
AI_PROVIDER=gemini
AI_API_KEY=
